}

/* ⚠️ SHEETS.TF = 'TalkFootball' / SHEETS.FV = 'FBVALUE' แต่คีย์ใน TEXT_COLS คือ 'TF'/'FV'
   ทางเข้าชีตส่ง "ชื่อชีตจริง" มา -> TEXT_COLS['TalkFootball'] = undefined
   สองแท็บนี้จึงไม่เคยถูกบังคับเป็นข้อความเลย ('3-0' กลายเป็นวันที่เงียบๆ)
   ตัวกลางนี้รับได้ทั้งชื่อชีตจริงและคีย์ — ห้ามอ่าน TEXT_COLS ตรงๆ อีก */
function textCols_(name) {
  if (TEXT_COLS[name]) return TEXT_COLS[name];
  for (var k in SHEETS) if (SHEETS[k] === name && TEXT_COLS[k]) return TEXT_COLS[k];
  return [];
}
